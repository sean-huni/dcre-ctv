<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      SCRUM-107 cleanout: dcre_col.mandate is a MANDATES concept that lived in the
      COLLECTIONS database, seeded by an infra fixture and owned by no service, which
      is why it appears in no changelog. CTV now reads dcre_man.man_ctv_view, the
      contract the mandates family owns and maintains.

      Dropped ONLY after the projection gate was proven on the cluster with BOTH
      verdicts. CONTINUE, not MARK_RAN: on a database that never had the table this
      must skip WITHOUT recording, or the skip becomes permanent (A-79).
    -->
    <changeSet id="001-drop-local-mandate" author="dcre">
        <preConditions onFail="CONTINUE"
                       onFailMessage="dcre_col.mandate already absent; nothing to drop.">
            <tableExists tableName="mandate"/>
        </preConditions>

        <dropTable tableName="mandate"/>

        <!--
          Deliberately EMPTY, and that is the honest option here (review I6).

          A rollback that re-created the table could not restore anything useful:
          the table was never in a changelog, so this changeset has no authored
          shape to return to, and the real one carried 17 columns, five CHECK
          constraints, a UNIQUE and two indexes. The 4-column stub this changeset
          originally shipped would have produced an empty table of a shape that
          never existed, which is worse than nothing: it would satisfy a
          "table exists" check while holding no rows and the wrong columns, and it
          would immediately trip the CtvManifestParityTest invariant that nothing
          re-creates dcre_col.mandate.

          Rolling this changeset back is therefore a restore-from-backup operation,
          not a Liquibase one. The data lived only in an infra fixture seed.
        -->
        <rollback/>
    </changeSet>

</databaseChangeLog>
